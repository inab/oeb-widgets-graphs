  "author": "Barcelona Supercomuting Center (BSC)",
  "license": "Apache-2.0",
  "description": "Collection of OEB widgets for graphs components",
  "keywords": [
    "lit",
    "OEB",
    "widgets",
    "visualization",
    "chart",
    "graphs",
    "scatter",
    "barplot",
